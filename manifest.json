{
  "manifest_version": 3,
  "name": "豆备 Doubak",
  "short_name": "豆备",
  "version": "0.0.1",
  "description": "在你自己的浏览器里备份豆瓣数据，存成标准 WARC 档案。所有数据留在本地。",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "unlimitedStorage",
    "alarms",
    "offscreen",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.douban.com/*",
    "https://*.doubanio.com/*"
  ],
  "action": {
    "default_title": "豆备 Doubak",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
